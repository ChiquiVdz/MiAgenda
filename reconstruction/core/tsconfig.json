{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "*.config.ts", "verify-retention.ts", "verify-integral.ts", "verify-recent-kitchen.ts", "verify-subtasks-preparations.ts", "performance-audit.ts", "performance-app-audit.ts"]
}
